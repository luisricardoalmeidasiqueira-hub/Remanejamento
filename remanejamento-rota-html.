<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Remanejamento de Rota</title>
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="192x192" href="data:image/png;base64,">

<style>
  :root{
    --bg: #ffffff;
    --panel: #ffffff;
    --panel-2: #f2f7f3;
    --line: #dbe8de;
    --text: #163422;
    --text-dim: #5c7864;
    --accent: #2f7a4f;
    --accent-dim: #cfe8d7;
    --accent-text: #ffffff;
    --red: #c85a40;
    --gray: #8a978f;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: var(--bg);
    color: var(--text);
    font-family: 'Georgia', 'Iowan Old Style', serif;
    min-height:100vh;
    padding: 18px 14px 40px;
  }
  .wrap{max-width:480px;margin:0 auto;}

  header{
    margin-bottom:20px;
    padding-bottom:14px;
    border-bottom: 1px solid var(--line);
  }
  header h1{
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 4px;
    letter-spacing: 0.2px;
    color: var(--accent);
  }
  header p{
    margin:0;
    color: var(--text-dim);
    font-size: 13px;
    font-family: -apple-system, system-ui, sans-serif;
  }

  .card{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 16px;
  }

  label{
    display:block;
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 12.5px;
    color: var(--text-dim);
    margin: 14px 0 6px;
  }
  label:first-of-type{margin-top:0;}

  input[type="text"], textarea{
    width:100%;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 16px;
    padding: 11px 12px;
    -webkit-appearance:none;
    appearance:none;
  }
  input:focus, textarea:focus{
    outline: none;
    border-color: var(--accent);
  }
  textarea{ resize:vertical; min-height:70px; }

  .save-btn{
    width:100%;
    margin-top:18px;
    padding: 14px;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--accent-text);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor:pointer;
  }
  .save-btn:active{ opacity:0.85; }
  .save-btn:disabled{ background: var(--gray); color:#fff; }

  .status-msg{
    text-align:center;
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 13px;
    color: var(--text-dim);
    margin-top: 10px;
    min-height: 16px;
  }

  .section-title{
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 13px;
    color: var(--text-dim);
    margin: 26px 2px 10px;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .section-title span.count{
    color: var(--accent);
    font-weight:600;
  }

  .filtro-rota{
    margin-bottom: 12px;
  }
  .filtro-rota input{
    width:100%;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 14px;
    padding: 10px 12px;
  }
  .filtro-rota input:focus{
    outline:none;
    border-color: var(--accent);
  }

  .entry{
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 10px;
    font-family: -apple-system, system-ui, sans-serif;
  }

  .entry-top{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:10px;
  }
  .entry-code{
    font-size: 15px;
    font-weight: 700;
    color: var(--accent);
  }
  .entry-date{
    font-size: 12px;
    color: var(--text-dim);
    white-space:nowrap;
  }
  .entry-meta{
    font-size: 12.5px;
    color: var(--text-dim);
    margin-top: 4px;
  }
  .entry-rota{
    font-weight:600;
    color: var(--accent);
  }

  .entry-obs{
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--text-dim);
    font-style: italic;
    border-top: 1px solid var(--line);
    padding-top: 6px;
  }

  /* Fotos */
  .foto-input-row{
    display:flex;
    gap:8px;
  }
  .foto-btn{
    flex:1;
    padding: 11px 8px;
    border-radius: 8px;
    border: 1px dashed var(--accent-dim);
    background: var(--panel-2);
    color: var(--accent);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor:pointer;
    text-align:center;
  }
  .foto-preview{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top: 10px;
  }
  .foto-thumb{
    position:relative;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow:hidden;
    border: 1px solid var(--line);
  }
  .foto-thumb img{
    width:100%;
    height:100%;
    object-fit: cover;
    display:block;
  }
  .foto-thumb .rm{
    position:absolute;
    top:2px;
    right:2px;
    width:18px;
    height:18px;
    border-radius:50%;
    background: rgba(0,0,0,0.65);
    color:#fff;
    border:none;
    font-size:11px;
    line-height:18px;
    text-align:center;
    cursor:pointer;
    padding:0;
  }
  .entry-fotos{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-top: 8px;
  }
  .entry-fotos img{
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--line);
    cursor:pointer;
  }
  .foto-modal{
    display:none;
    position:fixed;
    inset:0;
    background: rgba(0,0,0,0.88);
    z-index: 999;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    padding: 20px;
  }
  .foto-modal.open{ display:flex; }
  .foto-modal img{
    max-width: 100%;
    max-height: 70vh;
    border-radius: 8px;
  }
  .foto-modal-nav{
    display:flex;
    gap:14px;
    margin-top: 16px;
    font-family: -apple-system, system-ui, sans-serif;
  }
  .foto-modal-nav button{
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--text);
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    cursor:pointer;
  }
  .foto-modal-close{
    position:absolute;
    top: 18px;
    right: 18px;
    background:none;
    border:none;
    color:#fff;
    font-size: 26px;
    cursor:pointer;
    line-height:1;
  }

  .toggle-etapas-btn{
    width:100%;
    padding: 9px;
    margin-top: 8px;
    border-radius: 8px;
    border: 1px dashed var(--accent-dim);
    background: var(--panel-2);
    color: var(--accent);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor:pointer;
  }
  .etapa-opts{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-top: 10px;
  }
  .etapa-opts button{
    padding: 7px 4px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--panel-2);
    color: var(--text-dim);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    cursor:pointer;
  }
  .etapa-opts button:active{
    background: rgba(47,122,79,0.18);
    border-color: var(--accent);
    color: var(--accent);
  }

  .medidor-row{
    display:flex;
    gap:8px;
    margin-bottom: 8px;
  }
  .medidor-row input{
    flex:1;
  }
  .medidor-row .rm-medidor{
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--gray);
    border-radius: 8px;
    width: 40px;
    font-size: 16px;
    cursor:pointer;
  }
  .add-medidor-btn{
    width:100%;
    padding: 9px;
    margin-bottom: 4px;
    border-radius: 8px;
    border: 1px dashed var(--accent-dim);
    background: var(--panel-2);
    color: var(--accent);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor:pointer;
  }

  .entry.resolvido{
    opacity: 0.75;
  }
  .entry.digitado{
    border-left-color: var(--gray);
  }
  .entry-status-row{
    display:flex;
    gap:8px;
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }
  .entry-status-btn{
    flex:1;
    background:none;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 600;
    font-family: -apple-system, system-ui, sans-serif;
    cursor:pointer;
    padding: 6px 4px;
  }
  .entry-status-btn.marcado{
    background: rgba(47,122,79,0.15);
  }
  .entry-status-btn.digitado-btn{
    border-color: var(--gray);
    color: var(--gray);
  }
  .entry-status-btn.digitado-btn.marcado{
    background: rgba(138,151,143,0.15);
  }

  .entry-actions{
    display:flex;
    justify-content: flex-end;
    align-items:center;
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }
  .entry-del{
    background:none;
    border:none;
    color: var(--gray);
    font-size: 12px;
    font-family: -apple-system, system-ui, sans-serif;
    cursor:pointer;
    padding: 4px 0;
  }

  .empty{
    text-align:center;
    color: var(--text-dim);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 13px;
    padding: 30px 10px;
  }

  .export-btn{
    width:100%;
    padding: 11px;
    margin-bottom: 14px;
    border-radius: 8px;
    border: 1px solid var(--accent-dim);
    background: transparent;
    color: var(--accent);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
  }
  .export-btn:active{ opacity: 0.75; }
  .export-btn:disabled{
    color: var(--gray);
    border-color: var(--line);
    cursor: default;
  }

  footer.assinatura{
    text-align:center;
    margin-top: 26px;
    color: var(--accent);
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: 0.3px;
    opacity: 0.85;
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>Remanejamento de Rota</h1>
    <p>Cliente ligado no lugar certo, mas com rota errada no sistema</p>
  </header>

  <div class="card">
    <label for="codigo">Código do cliente *</label>
    <input type="text" id="codigo" inputmode="numeric" placeholder="Ex: 00123456" autocomplete="off">

    <label>Número do medidor *</label>
    <div id="medidorList"></div>
    <button type="button" class="add-medidor-btn" id="addMedidorBtn">+ Adicionar medidor</button>

    <label for="vizinha">Medidor ou UC vizinha *</label>
    <input type="text" id="vizinha" inputmode="text" placeholder="Ex: 987600 (referência de local)" autocomplete="off">

    <label for="rotaDestino">Etapa/rota que vai ser remanejado</label>
    <input type="text" id="rotaDestino" inputmode="text" placeholder="Ex: Rota 12 - Setor Norte" autocomplete="off">

    <button type="button" class="toggle-etapas-btn" id="toggleEtapasBtn">Mostrar etapas (1 a 18)</button>
    <div class="etapa-opts" id="etapaOpts" style="display:none;"></div>

    <label for="rua">Nome da rua</label>
    <input type="text" id="rua" inputmode="text" placeholder="Ex: Rua das Flores" autocomplete="off">

    <label>Fotos</label>
    <div class="foto-input-row">
      <button type="button" class="foto-btn" id="fotoBtn">📷 Adicionar foto(s)</button>
      <input type="file" id="fotoInput" accept="image/*" multiple capture="environment" style="display:none;">
    </div>
    <div class="foto-preview" id="fotoPreview"></div>

    <label for="obs">Observações</label>
    <textarea id="obs" placeholder="Detalhes adicionais (opcional)"></textarea>

    <button class="save-btn" id="saveBtn">Salvar registro</button>
    <div class="status-msg" id="statusMsg"></div>
  </div>

  <div class="section-title">
    <span>Registros salvos</span>
    <span class="count" id="entryCount">0</span>
  </div>

  <div class="filtro-rota">
    <input type="text" id="filtroRota" placeholder="Filtrar por rota/etapa..." autocomplete="off">
  </div>

  <button class="export-btn" id="exportBtn">Exportar registros (CSV)</button>
  <div id="entriesList"></div>

  <footer class="assinatura">Criado por Luis Ricardo</footer>
</div>

<div class="foto-modal" id="fotoModal">
  <button class="foto-modal-close" id="fotoModalClose">×</button>
  <img id="fotoModalImg" src="" alt="Foto">
  <div class="foto-modal-nav" id="fotoModalNav" style="display:none;">
    <button id="fotoModalPrev">‹ Anterior</button>
    <button id="fotoModalNext">Próxima ›</button>
  </div>
</div>

<script>
let entries = [];
const CHAVE_DADOS = 'remanejamento-rota-entries';
let usarArmazenamentoLocal = false;
let filtroAtual = '';
let medidorValores = [''];
let selectedFotos = []; // base64 das fotos ainda não salvas

function formatDateHora(timestamp){
  if(!timestamp) return '';
  const d = new Date(timestamp);
  const dd = String(d.getDate()).padStart(2,'0');
  const mm = String(d.getMonth()+1).padStart(2,'0');
  const yyyy = d.getFullYear();
  const hh = String(d.getHours()).padStart(2,'0');
  const min = String(d.getMinutes()).padStart(2,'0');
  return `${dd}/${mm}/${yyyy} ${hh}:${min}`;
}

function todayStr(){
  const d = new Date();
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth()+1).padStart(2,'0');
  const dd = String(d.getDate()).padStart(2,'0');
  return `${yyyy}-${mm}-${dd}`;
}

// ---- Medidores: múltiplos números de medidor por registro ----
function renderMedidorRows(){
  const box = document.getElementById('medidorList');
  box.innerHTML = medidorValores.map((val, i) => `
    <div class="medidor-row">
      <input type="text" inputmode="text" placeholder="Ex: 987654" class="medidor-input" data-i="${i}" value="${val}">
      ${medidorValores.length > 1 ? `<button type="button" class="rm-medidor" data-i="${i}">×</button>` : ''}
    </div>
  `).join('');

  box.querySelectorAll('.medidor-input').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      medidorValores[Number(inp.dataset.i)] = inp.value;
    });
  });

  box.querySelectorAll('.rm-medidor').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      medidorValores.splice(Number(btn.dataset.i), 1);
      renderMedidorRows();
    });
  });
}

document.getElementById('addMedidorBtn').addEventListener('click', ()=>{
  medidorValores.push('');
  renderMedidorRows();
});

renderMedidorRows();

// ---- Etapas rápidas (1 a 18): botão oculto que revela os números ----
const etapaOptsBox = document.getElementById('etapaOpts');
etapaOptsBox.innerHTML = Array.from({length:18}, (_,i)=> i+1).map(n =>
  `<button type="button" data-etapa="${n}">${n}</button>`
).join('');

const toggleEtapasBtn = document.getElementById('toggleEtapasBtn');
toggleEtapasBtn.addEventListener('click', ()=>{
  const aberto = etapaOptsBox.style.display !== 'none';
  etapaOptsBox.style.display = aberto ? 'none' : 'grid';
  toggleEtapasBtn.textContent = aberto ? 'Mostrar etapas (1 a 18)' : 'Ocultar etapas';
});

etapaOptsBox.querySelectorAll('button').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.getElementById('rotaDestino').value = btn.dataset.etapa;
  });
});

// ---- Fotos: compressão e preview ----
function compressImage(file){
  return new Promise((resolve, reject)=>{
    const reader = new FileReader();
    reader.onload = (e)=>{
      const img = new Image();
      img.onload = ()=>{
        const maxW = 900;
        let w = img.width, h = img.height;
        if(w > maxW){ h = Math.round(h * (maxW / w)); w = maxW; }
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', 0.6));
      };
      img.onerror = () => reject(new Error('Falha ao carregar imagem'));
      img.src = e.target.result;
    };
    reader.onerror = () => reject(new Error('Falha ao ler arquivo'));
    reader.readAsDataURL(file);
  });
}

function renderFotoPreview(){
  const box = document.getElementById('fotoPreview');
  box.innerHTML = selectedFotos.map((foto, i) => `
    <div class="foto-thumb">
      <img src="${foto}" data-i="${i}">
      <button class="rm" data-i="${i}" type="button">×</button>
    </div>
  `).join('');

  box.querySelectorAll('.rm').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      selectedFotos.splice(Number(btn.dataset.i), 1);
      renderFotoPreview();
    });
  });
}

document.getElementById('fotoBtn').addEventListener('click', ()=>{
  document.getElementById('fotoInput').click();
});

document.getElementById('fotoInput').addEventListener('change', async (e)=>{
  const files = Array.from(e.target.files || []);
  for(const file of files){
    try{
      const dataUrl = await compressImage(file);
      selectedFotos.push(dataUrl);
    }catch(err){
      console.error('Erro ao processar foto', err);
    }
  }
  renderFotoPreview();
  e.target.value = '';
});

// ---- Modal de visualização de fotos salvas ----
let modalFotos = [];
let modalIndex = 0;

function abrirModalFoto(fotos, index){
  modalFotos = fotos;
  modalIndex = index;
  atualizarModal();
  document.getElementById('fotoModal').classList.add('open');
}

function atualizarModal(){
  document.getElementById('fotoModalImg').src = modalFotos[modalIndex];
  document.getElementById('fotoModalNav').style.display = modalFotos.length > 1 ? 'flex' : 'none';
}

document.getElementById('fotoModalClose').addEventListener('click', ()=>{
  document.getElementById('fotoModal').classList.remove('open');
});
document.getElementById('fotoModal').addEventListener('click', (e)=>{
  if(e.target.id === 'fotoModal') document.getElementById('fotoModal').classList.remove('open');
});
document.getElementById('fotoModalPrev').addEventListener('click', ()=>{
  modalIndex = (modalIndex - 1 + modalFotos.length) % modalFotos.length;
  atualizarModal();
});
document.getElementById('fotoModalNext').addEventListener('click', ()=>{
  modalIndex = (modalIndex + 1) % modalFotos.length;
  atualizarModal();
});

function limparFormulario(){
  document.getElementById('codigo').value = '';
  medidorValores = [''];
  renderMedidorRows();
  document.getElementById('vizinha').value = '';
  document.getElementById('rotaDestino').value = '';
  document.getElementById('rua').value = '';
  document.getElementById('obs').value = '';
  selectedFotos = [];
  renderFotoPreview();
  document.getElementById('codigo').focus();
}

async function loadEntries(){
  if(!usarArmazenamentoLocal){
    try{
      const result = await window.storage.get(CHAVE_DADOS, false);
      entries = result && result.value ? JSON.parse(result.value) : [];
      renderEntries();
      return;
    }catch(e){
      usarArmazenamentoLocal = true;
    }
  }
  try{
    const raw = localStorage.getItem(CHAVE_DADOS);
    entries = raw ? JSON.parse(raw) : [];
  }catch(e){
    entries = [];
  }
  renderEntries();
}

async function saveEntries(){
  if(!usarArmazenamentoLocal){
    try{
      await window.storage.set(CHAVE_DADOS, JSON.stringify(entries), false);
      return;
    }catch(e){
      usarArmazenamentoLocal = true;
    }
  }
  try{
    localStorage.setItem(CHAVE_DADOS, JSON.stringify(entries));
  }catch(e){
    console.error('Erro ao salvar', e);
  }
}

function renderEntries(){
  const list = document.getElementById('entriesList');
  const termo = filtroAtual.trim().toLowerCase();
  const filtradas = termo
    ? entries.filter(e => (e.rotaDestino || '').toLowerCase().includes(termo))
    : entries;

  document.getElementById('entryCount').textContent = filtradas.length;
  atualizarBotaoExportar();

  if(filtradas.length === 0){
    list.innerHTML = `<div class="empty">${termo ? 'Nenhum registro encontrado para essa rota.' : 'Nenhum registro ainda. Preencha o formulário acima.'}</div>`;
    return;
  }

  const sorted = [...filtradas].sort((a,b)=> b.criadoEm - a.criadoEm);

  list.innerHTML = sorted.map(e => `
    <div class="entry${e.digitado ? ' digitado' : ''}">
      <div class="entry-top">
        <span class="entry-code">${e.codigo}</span>
        <span class="entry-date">${formatDateHora(e.criadoEm)}</span>
      </div>
      <div class="entry-meta">Medidor${(e.medidores && e.medidores.length > 1) ? 'es' : ''} <strong>${(e.medidores && e.medidores.length) ? e.medidores.join(', ') : '—'}</strong>${e.vizinha ? ` · UC vizinha <strong>${e.vizinha}</strong>` : ''}</div>
      <div class="entry-meta">Remanejar para: <span class="entry-rota">${e.rotaDestino || '—'}</span>${e.rua ? ` · ${e.rua}` : ''}</div>
      ${e.obs ? `<div class="entry-obs">${e.obs}</div>` : ''}
      ${e.fotos && e.fotos.length ? `<div class="entry-fotos" data-entry-id="${e.id}">${e.fotos.map((f,i)=>`<img src="${f}" data-i="${i}">`).join('')}</div>` : ''}
      ${e.digitado && e.digitadoEm ? `<div class="entry-meta">Digitado em ${formatDateHora(e.digitadoEm)}</div>` : ''}
      <div class="entry-status-row">
        <button class="entry-status-btn digitado-btn${e.digitado ? ' marcado' : ''}" data-action="digitado" data-id="${e.id}">${e.digitado ? 'Digitado ✓' : 'Marcar digitado'}</button>
      </div>
      <div class="entry-actions">
        <button class="entry-del" data-id="${e.id}">Excluir</button>
      </div>
    </div>
  `).join('');

  list.querySelectorAll('.entry-fotos').forEach(container=>{
    const entryId = container.dataset.entryId;
    const entry = entries.find(e => e.id === entryId);
    container.querySelectorAll('img').forEach(img=>{
      img.addEventListener('click', ()=>{
        abrirModalFoto(entry.fotos, Number(img.dataset.i));
      });
    });
  });

  list.querySelectorAll('.entry-status-btn').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      const entry = entries.find(e => e.id === btn.dataset.id);
      if(!entry) return;
      const campo = btn.dataset.action; // 'resolvido' ou 'digitado'
      entry[campo] = !entry[campo];
      entry[campo + 'Em'] = entry[campo] ? Date.now() : null;
      await saveEntries();
      renderEntries();
    });
  });

  list.querySelectorAll('.entry-del').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      entries = entries.filter(e => e.id !== btn.dataset.id);
      await saveEntries();
      renderEntries();
    });
  });
}

document.getElementById('filtroRota').addEventListener('input', (e)=>{
  filtroAtual = e.target.value;
  renderEntries();
});

document.getElementById('saveBtn').addEventListener('click', async ()=>{
  const codigo = document.getElementById('codigo').value.trim();
  const medidoresPreenchidos = medidorValores.map(v => v.trim()).filter(v => v !== '');
  const vizinha = document.getElementById('vizinha').value.trim();
  const rotaDestino = document.getElementById('rotaDestino').value.trim();
  const rua = document.getElementById('rua').value.trim();
  const obs = document.getElementById('obs').value.trim();
  const statusMsg = document.getElementById('statusMsg');

  if(!codigo){
    statusMsg.textContent = 'Informe o código do cliente.';
    statusMsg.style.color = 'var(--red)';
    return;
  }
  if(medidoresPreenchidos.length === 0){
    statusMsg.textContent = 'Informe ao menos um número de medidor.';
    statusMsg.style.color = 'var(--red)';
    return;
  }
  if(!vizinha){
    statusMsg.textContent = 'Informe o medidor ou UC vizinha.';
    statusMsg.style.color = 'var(--red)';
    return;
  }
  const btn = document.getElementById('saveBtn');
  btn.disabled = true;
  statusMsg.textContent = 'Salvando...';
  statusMsg.style.color = 'var(--text-dim)';

  const novoRegistro = {
    id: Date.now().toString(36) + Math.random().toString(36).slice(2,7),
    codigo,
    medidores: medidoresPreenchidos,
    vizinha,
    rotaDestino,
    rua,
    obs,
    fotos: [...selectedFotos],
    digitado: false,
    digitadoEm: null,
    criadoEm: Date.now()
  };

  entries.push(novoRegistro);
  await saveEntries();
  renderEntries();

  limparFormulario();

  btn.disabled = false;
  statusMsg.textContent = 'Registro salvo com sucesso.';
  statusMsg.style.color = 'var(--accent)';
  setTimeout(()=>{ statusMsg.textContent=''; }, 2500);
});

function escapeCsv(valor){
  const str = String(valor ?? '');
  if(str.includes(';') || str.includes('"') || str.includes('\n')){
    return '"' + str.replace(/"/g,'""') + '"';
  }
  return str;
}

function exportarCSV(){
  if(entries.length === 0) return;

  const cabecalho = ['Código do cliente','Número(s) do medidor','Medidor/UC vizinha','Rota de destino','Rua','Observações','Lançado em','Qtd. fotos','Digitado','Digitado em'];
  const linhas = [...entries]
    .sort((a,b)=> b.criadoEm - a.criadoEm)
    .map(e => [
      e.codigo,
      (e.medidores || []).join(' | '),
      e.vizinha || '',
      e.rotaDestino || '',
      e.rua || '',
      e.obs || '',
      formatDateHora(e.criadoEm),
      (e.fotos ? e.fotos.length : 0),
      e.digitado ? 'Sim' : 'Não',
      e.digitado ? formatDateHora(e.digitadoEm) : ''
    ].map(escapeCsv).join(';'));

  const csv = '\uFEFF' + [cabecalho.join(';'), ...linhas].join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);

  const a = document.createElement('a');
  a.href = url;
  a.download = `remanejamento-rota-${todayStr()}.csv`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function atualizarBotaoExportar(){
  const btn = document.getElementById('exportBtn');
  btn.disabled = entries.length === 0;
}

document.getElementById('exportBtn').addEventListener('click', exportarCSV);

loadEntries();
</script>
